{"nodes":[{"id":"inicio","type":"text","text":"# ContaBancaria\nEstado inicial: Carlos, saldo R$ 500","x":0,"y":0,"width":340,"height":120,"color":"4"},{"id":"depositar","type":"text","text":"## depositar(valor)\nvalor > 0?","x":420,"y":-100,"width":280,"height":110,"color":"3"},{"id":"depSim","type":"text","text":"saldo += valor","x":800,"y":-160,"width":240,"height":90,"color":"4"},{"id":"depNao","type":"text","text":"Saldo não muda","x":800,"y":0,"width":240,"height":90,"color":"1"},{"id":"sacar","type":"text","text":"## sacar(valor)\nvalor > 0 **e** valor <= saldo?","x":420,"y":160,"width":300,"height":120,"color":"3"},{"id":"saqSim","type":"text","text":"saldo -= valor\n\"Saque realizado\"","x":800,"y":140,"width":260,"height":100,"color":"4"},{"id":"saqNao","type":"text","text":"Saldo não muda\n\"Saque não permitido\"","x":800,"y":300,"width":260,"height":110,"color":"1"},{"id":"mostrar","type":"text","text":"## mostrarSaldo()\nExibe titular e saldo atual","x":1160,"y":100,"width":280,"height":110,"color":"6"}],"edges":[{"id":"e1","fromNode":"inicio","fromSide":"right","toNode":"depositar","toSide":"left"},{"id":"e2","fromNode":"inicio","fromSide":"right","toNode":"sacar","toSide":"left"},{"id":"e3","fromNode":"depositar","fromSide":"right","toNode":"depSim","toSide":"left","label":"sim"},{"id":"e4","fromNode":"depositar","fromSide":"right","toNode":"depNao","toSide":"left","label":"não"},{"id":"e5","fromNode":"sacar","fromSide":"right","toNode":"saqSim","toSide":"left","label":"sim"},{"id":"e6","fromNode":"sacar","fromSide":"right","toNode":"saqNao","toSide":"left","label":"não"},{"id":"e7","fromNode":"saqSim","fromSide":"right","toNode":"mostrar","toSide":"left"},{"id":"e8","fromNode":"depSim","fromSide":"right","toNode":"mostrar","toSide":"left"}]}
