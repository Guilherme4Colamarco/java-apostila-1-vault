{"nodes":[{"id":"inicio","type":"text","text":"# Principal.main()\nExecuta a demonstração das atividades em sequência","x":0,"y":100,"width":380,"height":130,"color":"4"},{"id":"a1","type":"text","text":"1. **Livro**\nexibir → emprestar → exibir → devolver → exibir","x":480,"y":-300,"width":340,"height":120,"color":"6"},{"id":"a2","type":"text","text":"2. **ContaBancaria**\ndepositar 200 → sacar 100 → tentar 1000","x":480,"y":-150,"width":340,"height":120,"color":"6"},{"id":"a3","type":"text","text":"3. **ReservaSala**\nexibir → reservar 2× → exibir → cancelar","x":480,"y":0,"width":340,"height":120,"color":"6"},{"id":"a4","type":"text","text":"4. **Produto**\nentrada 3 → saída 6 → tentativa 5","x":480,"y":150,"width":340,"height":110,"color":"6"},{"id":"a5","type":"text","text":"5. **Consulta**\nconfirmar → reagendar → cancelar","x":930,"y":-300,"width":320,"height":110,"color":"5"},{"id":"a6","type":"text","text":"6. **Aluno**\nexibir → alterar para Abandono → exibir","x":930,"y":-150,"width":330,"height":110,"color":"5"},{"id":"a7","type":"text","text":"7. **Pagamento**\nexibir → confirmar → exibir → cancelar → exibir","x":930,"y":0,"width":340,"height":120,"color":"5"},{"id":"a8","type":"text","text":"8. **Ingresso**\nusar → usar novamente","x":930,"y":160,"width":310,"height":100,"color":"5"},{"id":"fim","type":"text","text":"# Fim\nAs saídas mostram cada mudança de estado","x":1370,"y":0,"width":320,"height":120,"color":"4"}],"edges":[{"id":"e1","fromNode":"inicio","fromSide":"right","toNode":"a1","toSide":"left"},{"id":"e2","fromNode":"a1","fromSide":"bottom","toNode":"a2","toSide":"top"},{"id":"e3","fromNode":"a2","fromSide":"bottom","toNode":"a3","toSide":"top"},{"id":"e4","fromNode":"a3","fromSide":"bottom","toNode":"a4","toSide":"top"},{"id":"e5","fromNode":"a4","fromSide":"right","toNode":"a5","toSide":"left"},{"id":"e6","fromNode":"a5","fromSide":"bottom","toNode":"a6","toSide":"top"},{"id":"e7","fromNode":"a6","fromSide":"bottom","toNode":"a7","toSide"